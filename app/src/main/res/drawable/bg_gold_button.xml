<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item android:top="6dp" android:bottom="0dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="?attr/accentSoft" android:endColor="?attr/accent" />
                    <corners android:radius="28dp" />
                    <stroke android:width="1dp" android:color="?attr/glassStroke" />
                </shape>
            </item>
            <item android:left="1dp" android:right="1dp" android:top="7dp" android:bottom="0dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="#66FFFFFF" android:endColor="#00FFFFFF" />
                    <corners android:radius="28dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:top="6dp">
                <shape android:shape="rectangle">
                    <solid android:color="#B3000000" />
                    <corners android:radius="28dp" />
                </shape>
            </item>
            <item android:top="0dp" android:bottom="6dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="?attr/accentSoft" android:endColor="?attr/accent" />
                    <corners android:radius="28dp" />
                    <stroke android:width="1dp" android:color="?attr/glassStroke" />
                </shape>
            </item>
            <item android:left="1dp" android:right="1dp" android:top="1dp" android:bottom="6dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="#66FFFFFF" android:endColor="#00FFFFFF" />
                    <corners android:radius="28dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
