<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?attr/accentSoft">
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient android:angle="0" android:startColor="?attr/accent" android:endColor="?attr/accentSoft" />
                    <corners android:radius="28dp" />
                    <stroke android:width="1dp" android:color="?attr/glassStroke" />
                </shape>
            </item>
            <item android:left="1dp" android:right="1dp" android:top="1dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="#66FFFFFF" android:endColor="#00FFFFFF" />
                    <corners android:radius="28dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
