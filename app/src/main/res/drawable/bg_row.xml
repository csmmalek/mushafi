<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item android:top="4dp" android:bottom="0dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="?attr/glassTop" android:endColor="?attr/glassBottom" />
                    <corners android:radius="16dp" />
                    <stroke android:width="1dp" android:color="?attr/glassStroke" />
                </shape>
            </item>
            <item android:left="1dp" android:right="1dp" android:top="5dp" android:bottom="0dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="?attr/glassGloss" android:endColor="#00FFFFFF" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:top="4dp">
                <shape android:shape="rectangle">
                    <solid android:color="#99000000" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
            <item android:top="0dp" android:bottom="4dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="?attr/glassTop" android:endColor="?attr/glassBottom" />
                    <corners android:radius="16dp" />
                    <stroke android:width="1dp" android:color="?attr/glassStroke" />
                </shape>
            </item>
            <item android:left="1dp" android:right="1dp" android:top="1dp" android:bottom="4dp">
                <shape android:shape="rectangle">
                    <gradient android:angle="270" android:startColor="?attr/glassGloss" android:endColor="#00FFFFFF" />
                    <corners android:radius="16dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
