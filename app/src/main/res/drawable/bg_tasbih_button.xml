<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="?attr/accentSoft">
    <item>
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <gradient android:angle="315" android:startColor="?attr/accent" android:endColor="?attr/accentSoft" />
                    <stroke android:width="3dp" android:color="?attr/glassStroke" />
                </shape>
            </item>
            <item android:left="14dp" android:right="14dp" android:top="10dp" android:bottom="120dp">
                <shape android:shape="oval">
                    <gradient android:angle="270" android:startColor="#88FFFFFF" android:endColor="#00FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
