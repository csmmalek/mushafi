<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/appBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="40dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/app_title"
            android:textColor="?attr/accent"
            android:textSize="36sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/app_tagline"
            android:textColor="?attr/textMuted"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="@string/quran_loading"
            android:textColor="?attr/textPrimary"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_retry"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:text="@string/btn_retry"
            android:visibility="gone" />

        <Button
            android:id="@+id/btn_continue"
            android:layout_width="match_parent"
            android:layout_height="84dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_gold_button"
            android:enabled="false"
            android:text="@string/btn_continue"
            android:textColor="?attr/onAccent"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_quran"
                style="@style/HeroCard"
                android:drawableTop="@drawable/ic_quran"
                android:enabled="false"
                android:text="@string/btn_quran" />

            <Button
                android:id="@+id/btn_recitations"
                style="@style/HeroCard"
                android:drawableTop="@drawable/ic_recitations"
                android:enabled="false"
                android:text="@string/btn_recitations" />
        </LinearLayout>

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:columnCount="3">

        <Button
            android:id="@+id/btn_search"
            style="@style/TileCard"
            android:drawableTop="@drawable/ic_search"
            android:enabled="false"
            android:text="@string/btn_search" />

        <Button
            android:id="@+id/btn_bookmarks"
            style="@style/TileCard"
            android:drawableTop="@drawable/ic_bookmarks"
            android:enabled="false"
            android:text="@string/btn_bookmarks" />

        <Button
            android:id="@+id/btn_khatmah"
            style="@style/TileCard"
            android:drawableTop="@drawable/ic_khatmah"
            android:enabled="false"
            android:text="@string/btn_khatmah" />

        <Button
            android:id="@+id/btn_tasbih"
            style="@style/TileCard"
            android:drawableTop="@drawable/ic_tasbih"
            android:text="@string/btn_tasbih" />

        <Button
            android:id="@+id/btn_adhkar"
            style="@style/TileCard"
            android:drawableTop="@drawable/ic_adhkar"
            android:text="@string/btn_adhkar" />

        <Button
            android:id="@+id/btn_downloads"
            style="@style/TileCard"
            android:drawableTop="@drawable/ic_downloads"
            android:enabled="false"
            android:text="@string/btn_downloads" />

        <Button
            android:id="@+id/btn_settings"
            style="@style/TileCard"
            android:drawableTop="@drawable/ic_settings"
            android:text="@string/btn_settings" />

        <Button
            android:id="@+id/btn_help"
            style="@style/TileCard"
            android:drawableTop="@drawable/ic_help"
            android:text="@string/btn_help" />

        </GridLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center"
            android:text="@string/verification_notice"
            android:textColor="?attr/accent"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
