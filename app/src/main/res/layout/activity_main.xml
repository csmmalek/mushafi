<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/emerald_rich"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="48dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/app_title"
            android:textColor="@color/gold_light"
            android:textSize="36sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/app_tagline"
            android:textColor="@color/text_muted_dark"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/status_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="@string/quran_loading"
            android:textColor="@color/text_on_dark"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_retry"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:text="@string/btn_retry"
            android:visibility="gone" />

        <Button
            android:id="@+id/btn_continue"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_gold_button"
            android:enabled="false"
            android:text="@string/btn_continue"
            android:textColor="@color/emerald_rich"
            android:textSize="18sp"
            android:textStyle="bold" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:columnCount="2"
            android:rowCount="4">

            <Button
                android:id="@+id/btn_recitations"
                style="@style/FeatureCard"
                android:enabled="false"
                android:text="@string/btn_recitations" />

            <Button
                android:id="@+id/btn_quran"
                style="@style/FeatureCard"
                android:enabled="false"
                android:text="@string/btn_quran" />

            <Button
                android:id="@+id/btn_search"
                style="@style/FeatureCard"
                android:enabled="false"
                android:text="@string/btn_search" />

            <Button
                android:id="@+id/btn_bookmarks"
                style="@style/FeatureCard"
                android:enabled="false"
                android:text="@string/btn_bookmarks" />

            <Button
                android:id="@+id/btn_khatmah"
                style="@style/FeatureCard"
                android:enabled="false"
                android:text="@string/btn_khatmah" />

            <Button
                android:id="@+id/btn_downloads"
                style="@style/FeatureCard"
                android:enabled="false"
                android:text="@string/btn_downloads" />

            <Button
                android:id="@+id/btn_settings"
                style="@style/FeatureCard"
                android:text="@string/btn_settings" />
        </GridLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center"
            android:text="@string/verification_notice"
            android:textColor="@color/gold_light"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
