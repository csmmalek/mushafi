<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ivory"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/emerald_deep"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="32dp"
        android:paddingBottom="8dp">

        <Button
            style="@style/ChipButton"
            android:id="@+id/btn_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_back" />

        <Button
            style="@style/ChipButton"
            android:id="@+id/btn_bookmark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_bookmark" />

        <TextView
            android:id="@+id/reader_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="@color/gold_light"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

        <TextView
            android:id="@+id/surah_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:background="@drawable/bg_surah_header"
            android:gravity="center"
            android:padding="12dp"
            android:textColor="@color/gold_light"
            android:textSize="18sp"
            android:textStyle="bold" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/ayah_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:background="@drawable/bg_page_frame"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:clipToPadding="false" />

    <LinearLayout
        android:id="@+id/selection_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/emerald_mid"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/selection_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/gold_light"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_copy_ayah"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="@string/reader_copy_ayah" />

        <Button
            android:id="@+id/btn_bookmark_ayah"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="@string/reader_bookmark_ayah" />

        <Button
            android:id="@+id/btn_clear_selection"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="@string/reader_clear_selection" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/emerald_deep"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/reader_position"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingBottom="6dp"
            android:textColor="@color/text_on_dark"
            android:textSize="13sp" />

        <Button
            style="@style/ChipButton"
            android:id="@+id/btn_prev_surah"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/surah_prev" />

        <Button
            style="@style/ChipButton"
            android:id="@+id/btn_next_surah"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/surah_next" />

        <Button
            style="@style/ChipButton"
            android:id="@+id/btn_font_minus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/font_minus" />


        <Button
            style="@style/ChipButton"
            android:id="@+id/btn_font_plus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/font_plus" />
    </LinearLayout>
</LinearLayout>
