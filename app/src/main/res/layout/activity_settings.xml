<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/appBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_settings"
                android:textColor="?attr/accent"
                android:textSize="22sp"
                android:textStyle="bold" />

            <Button
                style="@style/ChipButton"
                android:id="@+id/btn_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_back" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/settings_section_appearance"
            android:textColor="?attr/accent"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/settings_app_theme"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/app_theme_0"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:buttonTint="?attr/accent"
                android:text="@string/app_theme_emerald"
                android:textColor="?attr/textPrimary" />

            <RadioButton
                android:id="@+id/app_theme_1"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:buttonTint="?attr/accent"
                android:text="@string/app_theme_night"
                android:textColor="?attr/textPrimary" />

            <RadioButton
                android:id="@+id/app_theme_2"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:buttonTint="?attr/accent"
                android:text="@string/app_theme_sapphire"
                android:textColor="?attr/textPrimary" />

            <RadioButton
                android:id="@+id/app_theme_3"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:buttonTint="?attr/accent"
                android:text="@string/app_theme_amber"
                android:textColor="?attr/textPrimary" />

            <RadioButton
                android:id="@+id/app_theme_4"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:buttonTint="?attr/accent"
                android:text="@string/app_theme_pearl"
                android:textColor="?attr/textPrimary" />
        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/settings_section_reading"
            android:textColor="?attr/accent"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/settings_page_theme"
            android:textColor="?attr/textPrimary" />

        <RadioGroup
            android:id="@+id/settings_page_theme"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/theme_0"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:buttonTint="?attr/accent"
                android:text="@string/theme_cream"
                android:textColor="?attr/textPrimary" />

            <RadioButton
                android:id="@+id/theme_1"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:buttonTint="?attr/accent"
                android:text="@string/theme_white"
                android:textColor="?attr/textPrimary" />

            <RadioButton
                android:id="@+id/theme_2"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:buttonTint="?attr/accent"
                android:text="@string/theme_sand"
                android:textColor="?attr/textPrimary" />

            <RadioButton
                android:id="@+id/theme_3"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:buttonTint="?attr/accent"
                android:text="@string/theme_night"
                android:textColor="?attr/textPrimary" />
        </RadioGroup>

        <TextView
            android:id="@+id/settings_font_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="?attr/textPrimary" />

        <SeekBar
            android:id="@+id/settings_font_seek"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:max="20"
            android:progressTint="?attr/accent"
            android:thumbTint="?attr/accent" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switch_exact"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/settings_exact"
            android:textColor="?attr/textPrimary" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switch_kashida"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/settings_kashida"
            android:textColor="?attr/textPrimary" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switch_keep_screen"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/settings_keep_screen"
            android:textColor="?attr/textPrimary" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switch_muqattaat"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/settings_muqattaat"
            android:textColor="?attr/textPrimary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_muqattaat_note"
            android:textColor="?attr/textMuted"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/settings_section_storage"
            android:textColor="?attr/accent"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/settings_storage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="?attr/textPrimary" />

        <Button
            style="@style/ChipButton"
            android:id="@+id/btn_clear_audio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:enabled="false"
            android:text="@string/settings_clear_button" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/settings_section_sources"
            android:textColor="?attr/accent"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/settings_sources_text"
            android:textColor="?attr/textPrimary"
            android:textSize="14sp"
            android:lineSpacingMultiplier="1.4" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/settings_section_privacy"
            android:textColor="?attr/accent"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/settings_privacy_text"
            android:textColor="?attr/textPrimary"
            android:textSize="14sp"
            android:lineSpacingMultiplier="1.4" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/settings_version"
            android:textColor="?attr/textMuted"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
