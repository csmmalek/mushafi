<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Mushafi" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/emerald_deep</item>
        <item name="colorPrimaryDark">@color/emerald_rich</item>
        <item name="colorAccent">@color/gold</item>
        <item name="android:windowBackground">@color/emerald_rich</item>
        <item name="android:statusBarColor">@color/emerald_rich</item>
        <item name="android:navigationBarColor">@color/emerald_rich</item>
        <item name="android:layoutDirection">rtl</item>
    </style>

    <style name="FeatureCard" parent="Widget.AppCompat.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">110dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_margin">6dp</item>
        <item name="android:background">@drawable/bg_feature_card</item>
        <item name="android:textColor">@color/text_on_dark</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="ChipButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:textColor">@color/gold_light</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
    </style>
</resources>
